#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        sym: symbol_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "SYMBOL_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        num: number_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMBER_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1      &kp N2       &kp N3       &kp N4     &kp N5   &tog 1                                                                     &mo 3          &kp N6  &kp N7    &kp N8        &kp N9       &kp N0         &kp MINUS
&kp LCTRL  &kp Q       &kp W        &kp E        &kp R      &kp T    &none                                                                      &none          &kp Y   &kp U     &kp I         &kp O        &kp SEMICOLON  &kp BSLH
&kp ESC    &hm LGUI A  &hm LCTRL S  &mt LSHFT D  &sym 4 F   &lt 6 G  &none      &mt LCTRL TAB  &kp DEL            &kp LGUI       &mt RCTRL TAB  &none          &kp H   &kp J     &mt RSHFT K   &hm RCTRL L  &hm RGUI P     &kp SQT
&kp LALT   &kp Z       &kp X        &num 5 C     &kp V      &kp B                              &kp HOME           &kp PG_UP                                    &kp N   &sym 4 M  &num 5 COMMA  &kp DOT      &kp SLASH      &kp RALT
&mo 2      &kp GRAVE   &kp CAPS     &kp LEFT     &kp RIGHT           &kp SPACE  &kp ESCAPE     &mt LSHFT TAB      &mt RSHFT TAB  &kp ENTER      &kp BACKSPACE          &kp UP    &kp DOWN      &kp LBKT     &kp RBKT       &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1      &kp N2       &kp N3       &kp N4     &kp N5    &trans                                                           &mo 3      &kp N6  &kp KP_NUM    &kp KP_EQUAL     &kp KP_DIVIDE    &kp KP_MULTIPLY   &kp MINUS
&kp LCTRL  &kp Q       &kp W        &kp E        &kp R      &kp T     &none                                                            &none      &kp Y   &kp KP_N7     &kp KP_N8        &kp KP_N9        &kp KP_MINUS      &kp BSLH
&kp ESC    &hm LGUI A  &hm LCTRL S  &mt LSHFT D  &kp F      &num 6 G  &none     &mt LCTRL TAB  &kp LALT      &kp LGUI   &mt RCTRL TAB  &none      &kp H   &kp KP_N4     &mt RSHFT KP_N5  &hm RCTRL KP_N6  &hm RGUI KP_PLUS  &kp SQT
&kp LALT   &kp Z       &kp X        &num 5 C     &sym 4 V   &kp B                              &kp HOME      &kp PG_UP                            &kp N   &sym 4 KP_N1  &num 5 KP_N2     &kp KP_N3        &kp KP_ENTER      &kp RALT
&mo 2      &kp GRAVE   &kp CAPS     &kp LEFT     &kp RIGHT            &kp BSPC  &kp DEL        &kp END       &kp PG_DN  &kp ENTER      &kp KP_N0          &kp UP        &kp DOWN         &kp KP_DOT       &kp RBKT          &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&trans  &trans      &trans      &trans      &trans  &trans      &trans                                                          &trans     &trans     &trans           &trans                &trans                 &trans         &trans
&trans  &trans      &trans      &trans      &trans  &trans      &none                                                           &none      &kp PIPE   &kp MINUS        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp AMPERSAND  &trans
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &trans  &kp LS(N5)  &none          &trans             &trans      &trans  &trans    &trans     &kp CARET  &kp UNDERSCORE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &kp DOLLAR
&trans  &trans      &trans      &trans      &trans  &trans                                        &trans      &trans                       &kp HASH   &kp EXCLAMATION  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AT_SIGN    &kp UNDER
&trans  &trans      &trans      &trans      &trans              &kp LS(EQUAL)  &kp DOUBLE_QUOTES  &trans      &trans  &kp PLUS  &kp EQUAL             &kp ASTERISK     &kp PERCENT           &kp COMMA              &trans         &trans
            >;
        };

        num {
            display-name = "Num";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none   &trans  &trans      &trans  &trans  &none   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        numpad {
            display-name = "Numpad";
            bindings = <
&kp EQUAL  &kp N1      &kp N2       &kp N3       &kp N4     &kp N5  &trans                                                           &mo 3   &kp N6  &kp N7     &kp EQUAL     &kp FSLH      &kp STAR       &kp MINUS
&kp LCTRL  &kp Q       &kp W        &kp E        &kp R      &kp T   &none                                                            &none   &kp Y   &kp N7     &kp N8        &kp N9        &kp MINUS      &kp BSLH
&kp ESC    &hm LGUI A  &hm LCTRL S  &mt LSHFT D  &kp F      &kp G   &none     &mt LCTRL TAB  &kp LALT      &kp LGUI   &mt RCTRL TAB  &none   &kp H   &kp N4     &mt RSHFT N5  &hm RCTRL N6  &hm RGUI PLUS  &kp SQT
&kp LALT   &kp Z       &kp X        &num 5 C     &sym 4 V   &kp B                            &kp HOME      &kp PG_UP                         &kp N   &sym 4 N1  &num 5 N2     &kp N3        &kp ENTER      &kp RALT
&mo 2      &kp GRAVE   &kp CAPS     &kp LEFT     &kp RIGHT          &kp BSPC  &kp DEL        &kp END       &kp PG_DN  &kp ENTER      &kp N0          &kp UP     &kp DOWN      &kp DOT       &kp RBKT       &mo 2
            >;
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
